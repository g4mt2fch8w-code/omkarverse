<style>svg.logo{overflow:visible}.ins-here{margin-right:auto;margin-left:16px;display:inline-flex;align-items:center;gap:12px;font:500 13px/1"JetBrains Mono",ui-monospace,monospace;letter-spacing:.06em;color:var(--brand);background:0 0;border:0;padding:8px 12px 8px 8px;border-radius:999px;cursor:pointer;white-space:nowrap;transition:background .3s}.ins-here:hover{background:color-mix(in srgb,var(--brand) 12%,transparent)}.ins-here .lbl i{font-style:normal;color:var(--muted);margin-right:6px}.ins-bg{position:relative;width:26px;height:18px;flex:0 0 auto}.ins-bg b,.ins-bg s{position:absolute;display:block;transition:transform .45s cubic-bezier(.2,.7,.1,1),width .45s cubic-bezier(.2,.7,.1,1),opacity .3s,top .45s cubic-bezier(.2,.7,.1,1)}.ins-bg b{left:0;top:0;width:6px;height:6px;border-radius:50%;background:var(--brand)}.ins-bg s:nth-of-type(1){left:10px;top:2px;width:16px;height:2px;background:var(--ink)}.ins-bg s:nth-of-type(2){left:0;top:11px;width:26px;height:2px;background:var(--ink)}.ins-here:hover .ins-bg s:nth-of-type(1){width:12px}.ins-here[aria-expanded=true] .ins-bg b{transform:scale(0);opacity:0}.ins-here[aria-expanded=true] .ins-bg s:nth-of-type(1){left:3px;top:8px;width:20px;transform:rotate(45deg)}.ins-here[aria-expanded=true] .ins-bg s:nth-of-type(2){left:3px;top:8px;width:20px;transform:rotate(-45deg)}.top>a{flex:0 0 auto}.ins-menu{position:fixed;inset:0;z-index:9;display:grid;align-items:center;padding:96px clamp(16px,3.2vw,44px) 48px;overflow:auto;overscroll-behavior:contain;background:color-mix(in srgb,var(--bg) 90%,transparent);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);opacity:0;transition:opacity .45s ease}.ins-menu[hidden]{display:none}.ins-menu.on{opacity:1}.ins-menu ol{list-style:none;margin:0 auto;padding:0;width:min(1100px,100%);columns:2 320px;column-gap:64px}.ins-menu li{break-inside:avoid}.ins-menu .sep{height:clamp(14px,3vh,28px)}.ins-menu .it{display:inline-block;font:300 clamp(1.5rem,3.4vw,2.6rem)/1.18 Inter,system-ui,sans-serif;letter-spacing:-.035em;color:var(--ink);text-decoration:none;padding:2px 0;transition:color .25s,transform .35s cubic-bezier(.2,.7,.1,1)}.ins-menu a.it:hover,.ins-menu a.it:focus-visible{color:var(--brand);transform:translateX(8px);outline:0}.ins-menu .now{color:var(--brand)}.ins-menu .now::before{content:"";display:inline-block;width:.32em;height:.32em;border-radius:50%;background:var(--brand);margin-right:.35em;vertical-align:.2em}.ins-menu .soon{color:var(--muted);opacity:.55}.ins-menu li.sub{padding-left:clamp(14px,1.6vw,22px);border-left:1px solid var(--line);margin-left:.12em}.ins-menu li.sub .it{font-size:clamp(1.05rem,2.05vw,1.55rem);line-height:1.32;color:color-mix(in srgb,var(--ink) 72%,var(--bg))}.ins-menu li.sub .now{color:var(--brand)}.ins-menu li.sub:has(+li.sub){padding-bottom:0}.ins-menu li.grp+li.sub{margin-top:4px}.ins-menu small{font:400 11px"JetBrains Mono",monospace;letter-spacing:.08em;vertical-align:.5em}.ins-menu .foot{display:none;margin:28px auto 0;width:min(1100px,100%)}.ins-menu .lk{display:inline-flex;border:1px solid var(--line);border-radius:999px;padding:3px}.ins-menu .lk button{font:500 12px/1"JetBrains Mono",monospace;color:var(--muted);background:0 0;border:0;border-radius:999px;padding:8px 14px;cursor:pointer}.ins-menu .lk button[aria-pressed=true]{background:var(--ink);color:var(--bg)}html.ins-pull{scroll-snap-type:none!important}.ins-lk1{display:none;flex:none;width:40px;height:40px;border:1px solid var(--line);border-radius:50%;background:0 0;padding:0;cursor:pointer;place-items:center;-webkit-tap-highlight-color:transparent}.ins-lk1 i{display:block;width:16px;height:16px;border:1.5px solid var(--ink);border-radius:50%;background:linear-gradient(90deg,var(--ink) 50%,transparent 50%);transition:transform .5s cubic-bezier(.2,.7,.1,1)}html[data-look=day] .ins-lk1 i{transform:rotate(180deg)}header.top>*{translate:0 var(--ins-vvt, 0px)}.ins-tilt{display:grid;flex:none;width:40px;height:40px;border:1px solid var(--line);b